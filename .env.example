# Telegram bot token from BotFather (server only — never commit real values)
BOT_TOKEN=

# Upstash Redis REST (server storage for bot chat → journal + Mini App sync)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: same value passed to setWebhook secret_token
TELEGRAM_WEBHOOK_SECRET=

# Optional: public Mini App URL (default https://between-rouge.vercel.app)
NEXT_PUBLIC_APP_URL=https://between-rouge.vercel.app

# Secret for the hourly digest caller (QStash or curl). Required for bot polls.
CRON_SECRET=

# Session brief, theme judge, and pattern text.
# When AITUNNEL_API_KEY is set, DeepSeek V4.1 Flash is used and Gemini/Groq are not called.
# Base URL https://api.aitunnel.ru/v1/  model deepseek-v4.1-flash-1017
# Put the key in Vercel → Settings → Environment Variables, then redeploy. Never commit it.
AITUNNEL_API_KEY=
# AITUNNEL_MODEL=deepseek-v4.1-flash-1017
# AITUNNEL_BASE_URL=https://ru-api.aitunnel.ru/v1
# Without the tunnel key, Gemini is tried first, then Groq (openai/gpt-oss-20b).
# llama-3.1-8b-instant was retired on 2026-08-16.
GEMINI_API_KEY=
GROQ_API_KEY=
# GROQ_MODEL=

# Stars charged every 30 days for the Week tab after the 14-day trial. 1–10000.
WEEK_STAR_PRICE=150

# Optional extra Telegram user ids that skip the Week subscription. Comma-separated.
# @aliatorovskaia is already exempt in src/lib/week-access.ts.
WEEK_EXEMPT_USER_IDS=
