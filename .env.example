# Telegram bot token from BotFather (server only — never commit real values)
BOT_TOKEN=

# Optional. Signs the browser session cookie for /journal.
# When empty, BOT_TOKEN is used instead.
# APP_SECRET=

# Browser sign-in. Each provider needs the callback registered exactly:
# https://between-rouge.vercel.app/api/account/oauth/vk/callback
# https://between-rouge.vercel.app/api/account/oauth/yandex/callback
# https://between-rouge.vercel.app/api/account/oauth/sber/callback
# VK ID: service token is the confidential-app key, not a user token.
# VK_CLIENT_ID=
# VK_SERVICE_TOKEN=
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# Sber ID token call wants the partner certificate. PEM, newlines as \n.
# SBER_CLIENT_ID=
# SBER_CLIENT_SECRET=
# SBER_CLIENT_CERT=
# SBER_CLIENT_KEY=

# Upstash Redis REST (server storage for bot chat → journal + Mini App sync)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: same value passed to setWebhook secret_token
TELEGRAM_WEBHOOK_SECRET=

# Optional: public Mini App URL (default https://between-rouge.vercel.app)
NEXT_PUBLIC_APP_URL=https://between-rouge.vercel.app

# Secret for the hourly digest caller (QStash or curl). Required for bot polls.
CRON_SECRET=

# Session brief, theme judge, pattern text, and bot voice notes.
# When AITUNNEL_API_KEY is set, DeepSeek V4.1 Flash is used and Gemini/Groq are not called.
# Base URL https://api.aitunnel.ru/v1/  model ~deepseek/deepseek-v4-flash-latest
# Voice notes use the same key: POST /audio/transcriptions, model whisper-1.
# The key allowlist must include whisper-1, or a voice note returns 403.
# Put the key in Vercel → Settings → Environment Variables, then redeploy. Never commit it.
# Must start with sk-aitunnel-. No quotes. Leave the key's IP list empty.
AITUNNEL_API_KEY=
# AITUNNEL_MODEL=~deepseek/deepseek-v4-flash-latest
# AITUNNEL_BASE_URL=https://ru-api.aitunnel.ru/v1
# Without the tunnel key, Gemini is tried first, then Groq (openai/gpt-oss-20b).
# llama-3.1-8b-instant was retired on 2026-08-16.
GEMINI_API_KEY=
GROQ_API_KEY=
# GROQ_MODEL=

# Stars for 30 days of Week after the 7-day trial. 1–10000.
# 3 months = this price × 3 with 20% off. 1 year = × 12 with 50% off.
WEEK_STAR_PRICE=150

# Usernames, without @, who can ask the bot for /stats. Default is aliatorovskaia.
# The command is not listed in the public menu. Counts have no Telegram id.
# ANALYTICS_OWNERS=aliatorovskaia

# PostHog US. Public project token only (phc_…). The server passes it into the browser.
# A personal API key (phx_…) is ignored. Leave empty and nothing is sent.
# POSTHOG_HOST defaults to https://us.i.posthog.com. Set the EU origin if the project lives there.
# Redeploy after changing these.
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Optional extra Telegram user ids with forever premium. Comma-separated.
# Usernames and finite spans live in PREMIUM_WHITELIST (aliatorovskaia = forever).
WEEK_EXEMPT_USER_IDS=
